{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockWatchlist",
  "type": "object",
  "required": ["symbols"],
  "properties": {
    "symbols": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "ticker", "name", "region"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ticker": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "name_zh": { "type": ["string", "null"] },
          "asset_class": { "type": "string", "minLength": 1, "default": "equity_stock" },
          "region": { "type": "string", "minLength": 1 },
          "currency": { "type": ["string", "null"] },
          "asset_type": {
            "type": "string",
            "enum": ["price", "yield"],
            "default": "price"
          },
          "display_precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "default": 2
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
