{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EconomicNewsWorkflowRegistry",
  "type": "object",
  "required": ["workflows"],
  "properties": {
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mode", "activation", "description", "example_config"],
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["analyze", "fetch", "briefing", "deliver", "check", "trend"]
          },
          "activation": {
            "type": "string",
            "enum": ["manual", "scheduled", "scheduled_or_manual"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "example_config": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
